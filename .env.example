# Copiez ce fichier en .env puis adaptez les valeurs (.env n'est jamais commité).

POSTGRES_DB=service_management
POSTGRES_USER=service_user
POSTGRES_PASSWORD=change-me

# Clé JWT en Base64 (le backend la décode en Base64) : openssl rand -base64 48
JWT_SECRET=
# Durée de validité du token en millisecondes (24 h par défaut)
JWT_EXPIRATION=86400000

# Ports exposés sur votre machine
FRONTEND_PORT=8080
BACKEND_PORT=8081
DB_PORT=5435
